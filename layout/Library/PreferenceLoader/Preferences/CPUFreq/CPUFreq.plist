<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>CPU频率控制</string>
	<key>entry</key>
	<dict>
		<key>cell</key>
		<string>PSLinkCell</string>
		<key>label</key>
		<string>CPU频率控制</string>
	</dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>总开关</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.infrastructure.cpufreq</string>
			<key>key</key>
			<string>Enabled</string>
			<key>label</key>
			<string>启用限频</string>
			<key>PostNotification</key>
			<string>com.infrastructure.cpufreq.reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>限频模式</string>
			<key>footerText</key>
			<string>原理: 通过"热仿真"让系统把CPU最高频率限制到指定档位（与 Powercuff 相同机制）。档位越高，CPU频率上限越低。注意: 只能限频，不能超频。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>default</key>
			<integer>0</integer>
			<key>defaults</key>
			<string>com.infrastructure.cpufreq</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>key</key>
			<string>Mode</string>
			<key>label</key>
			<string>模式</string>
			<key>validTitles</key>
			<array>
				<string>关闭 (不限制)</string>
				<string>标准 nominal</string>
				<string>轻度 light</string>
				<string>中度 moderate</string>
				<string>重度 heavy</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
				<integer>2</integer>
				<integer>3</integer>
				<integer>4</integer>
			</array>
			<key>PostNotification</key>
			<string>com.infrastructure.cpufreq.reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTextFieldCell</string>
			<key>defaults</key>
			<string>com.infrastructure.cpufreq</string>
			<key>key</key>
			<string>CustomMode</string>
			<key>label</key>
			<string>自定义模式</string>
			<key>placeholder</key>
			<string>如: moderate（留空则用上面的模式）</string>
			<key>PostNotification</key>
			<string>com.infrastructure.cpufreq.reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.infrastructure.cpufreq</string>
			<key>key</key>
			<string>RequireLowPowerMode</string>
			<key>label</key>
			<string>仅低电量模式下生效</string>
			<key>PostNotification</key>
			<string>com.infrastructure.cpufreq.reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>说明</string>
			<key>footerText</key>
			<string>修改任意选项后自动即时生效，无需注销。验证是否生效: NewTerm 执行 log stream --predicate 'eventMessage CONTAINS "CPUFreq"'，应看到 "[CPUFreq] applied thermal simulation mode: xxx"。</string>
		</dict>
	</array>
</dict>
</plist>
